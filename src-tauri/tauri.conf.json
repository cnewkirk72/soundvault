{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Soundvault",
  "version": "1.0.0",
  "identifier": "io.soundvault.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Soundvault",
        "width": 720,
        "height": 760,
        "minWidth": 680,
        "minHeight": 720,
        "maxWidth": 820,
        "maxHeight": 880,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "backgroundColor": "#08080d",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "copyright": "© 2026 Christian Newkirk",
    "shortDescription": "Find and consolidate your most-used Ableton samples.",
    "longDescription": "Soundvault scans a folder of Ableton Live projects, identifies your most frequently used samples across them, and consolidates the top picks into a single organized folder on disk. It is strictly read-only on your project files.",
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/taxonomy.json"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "dmg": {
        "background": null,
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "fs": {
      "scope": []
    }
  }
}
